include 'config_file/config_general.gin'

coco_extract:

    vqa_dataset=@VQAXDataset
    device=%DEVICE #name of used device Defaults to 'cpu'.
    
    sae_path=%SAE_PATH
    embedding_path=%EMBEDDING_COCO_PATH
    
VQAXDataset.path_folder=%DATASET_COCO_PATH

VQAXDataset.path_labels=%LABEL_TRAIN_COCO_PATH
